{"id":298,"date":"2026-02-13T20:07:11","date_gmt":"2026-02-13T20:07:11","guid":{"rendered":"https:\/\/advancedhealthimg.com\/about\/"},"modified":"2026-02-15T18:11:55","modified_gmt":"2026-02-15T18:11:55","slug":"about","status":"publish","type":"page","link":"https:\/\/advancedhealthimg.com\/about\/","title":{"rendered":"About"},"content":{"rendered":"\n<div class=\"wp-block-uagb-container uagb-layout-grid uagb-block-bfe052b1 alignfull uagb-is-root-container\"><div class=\"uagb-container-inner-blocks-wrap\">\n<div class=\"wp-block-uagb-advanced-heading uagb-block-4de6aee5\"><div class=\"uagb-separator\"><\/div><h1 class=\"uagb-heading-text\">why choose us<\/h1><\/div>\n\n\n\n<div class=\"wp-block-uagb-image uagb-block-259aae54 wp-block-uagb-image--layout-default wp-block-uagb-image--effect-static wp-block-uagb-image--align-none\"><figure class=\"wp-block-uagb-image__figure\"><img decoding=\"async\" srcset=\"https:\/\/advancedhealthimg.com\/wp-content\/uploads\/2026\/02\/circleonlyahi-logo.jpg ,https:\/\/advancedhealthimg.com\/wp-content\/uploads\/2026\/02\/circleonlyahi-logo.jpg 780w, https:\/\/advancedhealthimg.com\/wp-content\/uploads\/2026\/02\/circleonlyahi-logo.jpg 360w\" sizes=\"auto, (max-width: 480px) 150px\" src=\"https:\/\/advancedhealthimg.com\/wp-content\/uploads\/2026\/02\/circleonlyahi-logo.jpg\" alt=\"Circleonlyahi Logo\" class=\"uag-image-15\" width=\"396\" height=\"380\" title=\"ahi-logo\" loading=\"lazy\" role=\"img\"><\/figure><\/div>\n<\/div><\/div>\n\n\n\n<div class=\"wp-block-uagb-container uagb-block-b6c01382 alignfull uagb-is-root-container\"><div class=\"uagb-container-inner-blocks-wrap\">\n<div class=\"wp-block-uagb-image uagb-block-ee911b6e wp-block-uagb-image--layout-default wp-block-uagb-image--effect-static wp-block-uagb-image--align-none\"><figure class=\"wp-block-uagb-image__figure\"><img decoding=\"async\" srcset=\"https:\/\/advancedhealthimg.com\/wp-content\/uploads\/2026\/02\/pexels-photo-7088538-683x1024.jpeg ,https:\/\/advancedhealthimg.com\/wp-content\/uploads\/2026\/02\/pexels-photo-7088538.jpeg 780w, https:\/\/advancedhealthimg.com\/wp-content\/uploads\/2026\/02\/pexels-photo-7088538.jpeg 360w\" sizes=\"auto, (max-width: 480px) 150px\" src=\"https:\/\/advancedhealthimg.com\/wp-content\/uploads\/2026\/02\/pexels-photo-7088538-683x1024.jpeg\" alt=\"Health worker examines MRI scan data in a clinical setting.\" class=\"uag-image-21\" width=\"1200\" height=\"450\" title=\"pexels photo 7088538\" loading=\"lazy\" role=\"img\"\/><\/figure><\/div>\n\n\n\n<div class=\"wp-block-uagb-container uagb-block-3ac84b20\">\n<div class=\"wp-block-uagb-container uag-blocks-common-selector uagb-block-0bc34e4a\">\n<div class=\"wp-block-uagb-advanced-heading uagb-block-7752a12a\"><div class=\"uagb-separator\"><\/div><h2 class=\"uagb-heading-text\">Committed to Exceptional Imaging <\/h2><\/div>\n\n\n\n<div class=\"wp-block-uagb-image uagb-block-d2071441 wp-block-uagb-image--layout-default wp-block-uagb-image--effect-static wp-block-uagb-image--align-none\"><figure class=\"wp-block-uagb-image__figure\"><img decoding=\"async\" srcset=\"https:\/\/advancedhealthimg.com\/wp-content\/uploads\/2026\/02\/download.jpeg ,https:\/\/advancedhealthimg.com\/wp-content\/uploads\/2026\/02\/download.jpeg 780w, https:\/\/advancedhealthimg.com\/wp-content\/uploads\/2026\/02\/download.jpeg 360w\" sizes=\"auto, (max-width: 480px) 150px\" src=\"https:\/\/advancedhealthimg.com\/wp-content\/uploads\/2026\/02\/download.jpeg\" alt=\"download\" class=\"uag-image-653\" width=\"559\" height=\"400\" title=\"download\" loading=\"lazy\" role=\"img\"\/><\/figure><\/div>\n<\/div>\n\n\n\n<div class=\"wp-block-uagb-advanced-heading uagb-block-90bd4abb\"><h3 class=\"uagb-heading-text\">Advanced Health Imaging is a premium concierge facility specializing in comprehensive imaging services for patients of all ages.<\/h3><p class=\"uagb-desc-text\">With a commitment to excellence, Advanced Health Imaging combines cutting edge technology with a team of board-certified Radiologists to deliver high quality imaging services. We prioritize patient comfort and convenience, ensuring that both patients and physicians can easily access their imaging results through dedicated portals, fostering transparency and trust in healthcare.<\/p><\/div>\n<\/div>\n<\/div><\/div>\n\n\n\n<div class=\"wp-block-uagb-container uagb-block-b7e83894 alignfull uagb-is-root-container\"><div class=\"uagb-container-inner-blocks-wrap\">\n<div class=\"wp-block-uagb-advanced-heading uagb-block-1fe48051\"><div class=\"uagb-separator\"><\/div><h2 class=\"uagb-heading-text\">Discover Our Quality Imaging Services<\/h2><p class=\"uagb-desc-text\">We achieve accurate results swiftly, offer same day STAT appointments; empowering our clients and physicians to make informed decisions regarding their health with confidence.<\/p><\/div>\n\n\n<div class=\"wp-block-uagb-faq uagb-faq__outer-wrap uagb-block-20e9f1df uagb-faq-icon-row-reverse uagb-faq-layout-accordion uagb-faq-expand-first-true uagb-faq-inactive-other-true uagb-faq__wrap uagb-buttons-layout-wrap uagb-faq-equal-height     \" data-faqtoggle=\"true\" role=\"tablist\"><div class=\"wp-block-uagb-faq-child uagb-faq-child__outer-wrap uagb-faq-item uagb-block-e85bdb9d \" role=\"tab\" tabindex=\"0\"><div class=\"uagb-faq-questions-button uagb-faq-questions\">\t\t\t<span class=\"uagb-icon uagb-faq-icon-wrap\">\n\t\t\t\t\t\t\t\t<svg xmlns=\"https:\/\/www.w3.org\/2000\/svg\" viewBox= \"0 0 448 512\"><path d=\"M416 352c-8.188 0-16.38-3.125-22.62-9.375L224 173.3l-169.4 169.4c-12.5 12.5-32.75 12.5-45.25 0s-12.5-32.75 0-45.25l192-192c12.5-12.5 32.75-12.5 45.25 0l192 192c12.5 12.5 12.5 32.75 0 45.25C432.4 348.9 424.2 352 416 352z\"><\/path><\/svg>\n\t\t\t\t\t\t\t<\/span>\n\t\t\t\t\t\t<span class=\"uagb-icon-active uagb-faq-icon-wrap\">\n\t\t\t\t\t\t\t\t<svg xmlns=\"https:\/\/www.w3.org\/2000\/svg\" viewBox= \"0 0 448 512\"><path d=\"M224 416c-8.188 0-16.38-3.125-22.62-9.375l-192-192c-12.5-12.5-12.5-32.75 0-45.25s